[Unit]
Description=MU300 audio DSP memory (taken from the kernel before anything else uses it)
# Put here by mu300-audio's hooks/link. As early as the extra on /mnt/mu300-disk can be reached: the later, the more
# of the range is in use.
DefaultDependencies=no
RequiresMountsFor=/mnt/mu300-disk
Before=sysinit.target mu300-audio.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/opt/mu300/bin/mu300-audio-dsp

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/mu300/bin/mu300-audio-dsp reserve

[Install]
WantedBy=sysinit.target
